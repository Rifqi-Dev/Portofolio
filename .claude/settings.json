            "command": "node \"G:/My Drive/kapuyuax-vault/office/template/hook-relay.mjs\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"G:/My Drive/kapuyuax-vault/office/template/hook-relay.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
